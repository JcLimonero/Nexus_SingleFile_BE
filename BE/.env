#--------------------------------------------------------------------
# CONFIGURACIÓN PARA PUERTO 402
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# URL base: localhost para desarrollo local, 74.208.78.55:8092 para servidor
app.baseURL = 'http://localhost:8083/'

# URL del frontend para el enlace del miniportal (compartir por WhatsApp)
# En producción: usar la URL real del frontend (ej: https://tu-dominio.com/)
miniportal.frontendUrl = 'http://localhost:4200'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# Configuración de base de datos
database.default.hostname = 127.0.0.1
database.default.database = single_file
database.default.username = root
database.default.password = root
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Clave de encriptación (genera una nueva para producción)
encryption.key = tu_clave_de_encriptacion_segura_aqui

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------

# Para desarrollo local en puerto 402
app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# PDF GENERATOR API (identificación de cliente)
#--------------------------------------------------------------------

pdfGenerator.apiKey = 7f9fc263879cc6fb82cc8fac72e50e6028ed32e53c6334b9f9e516acbe1bacc1
pdfGenerator.apiSecret = 54ce5a1cb617858d1243a5be7ea099e2d5de95606bee83c4f3b60245ca79cddd
# Email del workspace = email con el que te registraste en PDF Generator API (https://app.pdfgeneratorapi.com/settings)
pdfGenerator.workspaceEmail = carlos.limon@nexusqtech.com
pdfGenerator.templateIdIdentificacionMoral = 1606181
pdfGenerator.templateIdIdentificacionFisico = 1606176

#--------------------------------------------------------------------
# NEXFILE (DWH) - URL del DWH para customers, orders, invoices
#--------------------------------------------------------------------
NEXFILE_BASE_URL = http://localhost:8082
NEXFILE_PROVIDER_TOKEN = 9f0ffe8d4df718a8db0a84f84b2bd89da07e7c5c266a4b306e0243f009f16f60

#--------------------------------------------------------------------
# JWT (autenticación). Generar con: php -r "echo bin2hex(random_bytes(48));"
#--------------------------------------------------------------------
JWT_SECRET = 103c4796926cf1eaa038941a3c778ace2b0a893aabe6cd3de4a4660d8877dfe9a752012953879166c2f89be0749cf0e4
JWT_ACCESS_TTL = 10800
JWT_REFRESH_TTL = 2592000

#--------------------------------------------------------------------
# RESPONSE FORMAT (migración snake_case del contrato API)
#--------------------------------------------------------------------
# Cuando se active, el filter `snake_resp` aplica snakeKeys() a TODA
# response JSON /api/* automáticamente. Default false porque romperá
# cualquier FE que lea camelCase directo sin fallback. Activar cuando
# todos los consumers FE hayan migrado o tengan mapper (ver
# core/utils/api-mappers.ts).
RESPONSE_SNAKE_CASE = true

#--------------------------------------------------------------------
# CORS (whitelist explícita — requerido con cookies httpOnly)
#--------------------------------------------------------------------
# CSV de orígenes permitidos. Browsers NO aceptan '*' cuando
# supportsCredentials=true. En prod incluir la URL del FE (Vercel).
CORS_ALLOWED_ORIGINS = http://localhost:4200

#--------------------------------------------------------------------
# SERVER CONFIGURATION
#--------------------------------------------------------------------

# Configuración específica para puerto 402
app.indexPage = 'index.php'
app.uriProtocol = 'REQUEST_URI'
