<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Documento por defecto -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <!-- Reglas de reescritura de URL -->
        <rewrite>
            <rules>
                <!-- Regla 0: Responder OPTIONS directamente (CORS preflight) -->
                <rule name="OPTIONS Preflight" stopProcessing="true">                                                              
                    <match url=".*" />                                                                                             
                    <conditions>                                                                                                   
                        <add input="{REQUEST_METHOD}" pattern="OPTIONS" />                                                         
                    </conditions>                                                                                                  
                    <action type="CustomResponse" statusCode="200" statusReason="Preflight" statusDescription="Preflight" />       
                </rule>  
                <!-- Regla 1: Redirigir index.php en la URL a la versión limpia -->
                <rule name="Remove index.php" stopProcessing="true">
                    <match url="^index\.php/(.*)$" />
                    <action type="Redirect" url="{R:1}" redirectType="Permanent" />
                </rule>

                <!-- Regla 2: Reescribir todas las peticiones a index.php (excepto archivos/directorios reales) -->
                <rule name="CodeIgniter4 Rewrite" stopProcessing="true">
                    <match url="^(.*)$" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <!-- No reescribir si es un archivo real -->
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
                        <!-- No reescribir si es un directorio real -->
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php?/{R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>

        <!-- Deshabilitar navegación de directorios -->
        <directoryBrowse enabled="false" />

        <!-- Handler para PHP 8.1 vía FastCGI -->                                                                          
        <handlers>                                                                                                         
            <clear />                                                                                                      
            <add name="PHP81_via_FastCGI"                                                                                  
                path="*.php"                                                                                              
                verb="GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS"                                                             
                modules="FastCgiModule"                                                                                   
                scriptProcessor="C:\php81\php-cgi.exe"                                                                    
                resourceType="Either"                                                                                     
                requireAccess="Script" />                                                                                 
        </handlers>   

        <!-- Configuración de errores HTTP -->
        <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

        

        <!-- Configuración de seguridad -->
        <security>
            <requestFiltering>
                <!-- Límite de tamaño de request: 100MB -->
                <requestLimits maxAllowedContentLength="104857600" maxQueryString="2048" />

                <!-- Permitir todos los verbos HTTP necesarios -->
                <verbs allowUnlisted="true">
                    <add verb="GET" allowed="true" />
                    <add verb="POST" allowed="true" />
                    <add verb="PUT" allowed="true" />
                    <add verb="PATCH" allowed="true" />
                    <add verb="DELETE" allowed="true" />
                    <add verb="OPTIONS" allowed="true" />
                    <add verb="HEAD" allowed="true" />
                </verbs>
            </requestFiltering>
        </security>

        <!-- Headers HTTP personalizados -->                                                                               
        <httpProtocol>                                                                                                     
            <customHeaders>                                                                                                
                <add name="Access-Control-Allow-Origin" value="http://74.208.78.55:8091" />                                
                <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, PATCH, DELETE, OPTIONS" />                 
                <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization, X-Requested-With, Accept,     
        Origin" />                                                                                                         
                <add name="Access-Control-Max-Age" value="7200" />                                                         
                <add name="X-Content-Type-Options" value="nosniff" />                                                      
                <add name="X-Frame-Options" value="SAMEORIGIN" />                                                          
            </customHeaders>                                                                                               
        </httpProtocol>  

        <!-- Configuración de compresión estática -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />

        <!-- Configuración de caché estática -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
        </staticContent>

    </system.webServer>

</configuration>
