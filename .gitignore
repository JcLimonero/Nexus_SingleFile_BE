
venv-pillow/

# Dependencias
node_modules/
BE/vendor/
FE/node_modules/

# Entornos y secretos
BE/.env
BE/env
BE/env.backup
BE/env.port402
BE/env.production
BE/config/database-config.json
ADMIN_BE/.env

# PHPUnit overrides locales con creds DB — phpunit.xml.dist es público
BE/phpunit.xml
DWH/phpunit.xml
ADMIN_BE/phpunit.xml
.env
.env.local
.env.*.local
*.env.bak

# Central DB config (shared across BE, ADMIN_BE, WIZARD) — contains the
# decryption key + DB password. Lives only on ops machines, never in git.
config/central.env
!config/central.env.template

# Builds y deploy
FE/dist/
!FE/dist/
*-deploy.zip
DWH-deploy.zip
FE-DEPLOY-CONFIGURABLE.zip

# OS / IDE
.DS_Store
**/.DS_Store
.vscode/
.idea/

# Logs
*.log
!FE/dist/
!FE/dist/*
!FE/dist/favicon.ico
# ignore local FE overrides
FE/src/environments/environment.ts

# BE/writable - ignorar todo excepto archivos de estructura (index.html, .htaccess)
BE/writable/*
!BE/writable/index.html
!BE/writable/.htaccess
!BE/writable/cache/
BE/writable/cache/*
!BE/writable/cache/index.html
!BE/writable/logs/
BE/writable/logs/*
!BE/writable/logs/index.html
!BE/writable/session/
BE/writable/session/*
!BE/writable/session/index.html
!BE/writable/uploads/
BE/writable/uploads/*
!BE/writable/uploads/index.html
BE/writable/debugbar/
BE/writable/.DS_Store

# Archivos de deploy generados
*-deploy.zip
